# MindBloom Environment Variables
# The application runs out-of-the-box in local demo mode without any external keys required.
# Add your live keys below to connect to live Supabase and AI APIs.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Content Generation (Claude or OpenAI)
CLAUDE_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...

# Regional Voice TTS/STT (Bhashini India)
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_USER_ID=your-bhashini-user-id
